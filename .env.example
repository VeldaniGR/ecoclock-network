  # Eco'clock Network — Variables de entorno                                                                                                                                                                        
  # Copia este archivo a .env y rellena los valores reales.                                                                                                                                                         
  # .env está en .gitignore, .env.example SÍ se sube al repo.                                                                                                                                                       
                                                                                                                                                                                                                    
  # Database (PostgreSQL via docker-compose)                                                                                                                                                                        
  DATABASE_URL=postgresql://ecoclock:ecoclock@localhost:5432/ecoclock                                                                                                                                               
                                                                                                                                                                                                                    
  # Auth (JWT)                                                                                                                                                                                                      
  # Genera uno nuevo con: python -c "import secrets; print(secrets.token_hex(32))"                                                                                                                                  
  SECRET_KEY=cambia-esto-por-un-hex-de-64-caracteres                                                                                                                                                                
  ALGORITHM=HS256                                                                                                                                                                                                   
  ACCESS_TOKEN_EXPIRE_MINUTES=30                                                                                                                                                                                    
